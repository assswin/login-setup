# ==========================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ==========================================

# 1. JWT Security Key (Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=replace-with-a-very-strong-secret-key

# 2. Database URL (Default: local SQLite database with WAL mode)
# For PostgreSQL in production: postgresql://user:password@localhost:5432/auth_db
DATABASE_URL=sqlite:///auth_database.db

# 3. Allowed CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173

# 4. Email OTP Delivery (Gmail SMTP - Free 500 emails/day)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# 5. Temporary Admin Passcode (Default: 735195)
ADMIN_PASSCODE=735195
